<div
  data-controller="mini-program"
  data-mini-program-direct-value="true"
  data-mini-program-url-value="/pages/login/index"
  data-mini-program-data-value="<%=
    {
      url: url_for(controller: 'wechat/program_users', action: 'create', host: request.domain),
      host: request.host,
      state: state,
      auth_appid: Rails.configuration.x.appid.presence
    }.compact.to_json
  %>"
>
  <span data-mini-program-target="hidden">登录信息失效，等待授权...</span>
  <span data-mini-program-target="show" style="display: none">点击重新加载</span>
</div>
